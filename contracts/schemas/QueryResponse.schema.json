{
  "$defs": {
    "QueryMethod": {
      "enum": [
        "basic",
        "local",
        "global",
        "drift"
      ],
      "title": "QueryMethod",
      "type": "string"
    },
    "QueryPurpose": {
      "enum": [
        "general",
        "entity_neighborhood",
        "experiment",
        "offline_evaluation",
        "long_task_approved"
      ],
      "title": "QueryPurpose",
      "type": "string"
    },
    "QueryStatus": {
      "enum": [
        "succeeded",
        "degraded",
        "timeout",
        "failed"
      ],
      "title": "QueryStatus",
      "type": "string"
    },
    "SafeDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "container_cleanup_succeeded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Container Cleanup Succeeded"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "internal_error_events": {
          "minimum": 0,
          "title": "Internal Error Events",
          "type": "integer"
        },
        "public_message": {
          "title": "Public Message",
          "type": "string"
        },
        "response_truncated": {
          "title": "Response Truncated",
          "type": "boolean"
        },
        "stderr_present": {
          "title": "Stderr Present",
          "type": "boolean"
        },
        "warning_events": {
          "minimum": 0,
          "title": "Warning Events",
          "type": "integer"
        }
      },
      "required": [
        "public_message",
        "exit_code",
        "stderr_present",
        "internal_error_events",
        "warning_events",
        "container_cleanup_succeeded",
        "response_truncated"
      ],
      "title": "SafeDiagnostics",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "openalex_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openalex Id"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "corpus_id": {
      "const": "openalex-rag-abstracts-2020-2025-v1",
      "default": "openalex-rag-abstracts-2020-2025-v1",
      "title": "Corpus Id",
      "type": "string"
    },
    "diagnostics": {
      "$ref": "#/$defs/SafeDiagnostics"
    },
    "duration_seconds": {
      "minimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "evidence_level": {
      "const": "abstract",
      "default": "abstract",
      "title": "Evidence Level",
      "type": "string"
    },
    "graphrag_version": {
      "const": "3.1.2",
      "default": "3.1.2",
      "title": "Graphrag Version",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/QueryMethod"
    },
    "purpose": {
      "$ref": "#/$defs/QueryPurpose"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_version": {
      "const": "1.2.0",
      "default": "1.2.0",
      "title": "Service Version",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/QueryStatus"
    }
  },
  "required": [
    "request_id",
    "method",
    "purpose",
    "status",
    "duration_seconds",
    "answer",
    "source_refs",
    "diagnostics"
  ],
  "title": "QueryResponse",
  "type": "object"
}
