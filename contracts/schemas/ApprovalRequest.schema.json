{
  "$defs": {
    "BudgetPlan": {
      "properties": {
        "estimate_source": {
          "title": "Estimate Source",
          "type": "string"
        },
        "is_actual_bill": {
          "default": false,
          "title": "Is Actual Bill",
          "type": "boolean"
        },
        "max_api_calls": {
          "title": "Max Api Calls",
          "type": "integer"
        },
        "max_cny": {
          "title": "Max Cny",
          "type": "number"
        },
        "max_wall_clock_seconds": {
          "title": "Max Wall Clock Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_cny",
        "max_api_calls",
        "max_wall_clock_seconds",
        "estimate_source"
      ],
      "title": "BudgetPlan",
      "type": "object"
    },
    "ExecutionAuthorization": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "max_cny": {
          "title": "Max Cny",
          "type": "string"
        },
        "max_external_requests": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max External Requests",
          "type": "integer"
        },
        "max_local_calls": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Local Calls",
          "type": "integer"
        },
        "max_remote_calls": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Max Remote Calls",
          "type": "integer"
        },
        "policy_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        }
      },
      "required": [
        "max_cny",
        "max_remote_calls",
        "max_local_calls",
        "max_external_requests",
        "policy_sha256",
        "generation"
      ],
      "title": "ExecutionAuthorization",
      "type": "object"
    },
    "PlanDetails": {
      "additionalProperties": false,
      "description": "Coordinator constraints that remain visible and bound to every approval.",
      "properties": {
        "inclusion_criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Inclusion Criteria",
          "type": "array"
        },
        "objective": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "retrieval_cutoff": {
          "format": "date",
          "title": "Retrieval Cutoff",
          "type": "string"
        },
        "subquestions": {
          "items": {
            "$ref": "#/$defs/ResearchSubquestion"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Subquestions",
          "type": "array"
        },
        "title": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "objective",
        "inclusion_criteria",
        "subquestions",
        "retrieval_cutoff"
      ],
      "title": "PlanDetails",
      "type": "object"
    },
    "PlanModification": {
      "additionalProperties": false,
      "description": "Complete editable content of a delivery plan; no identity or approval fields.",
      "properties": {
        "budget_plan": {
          "$ref": "#/$defs/BudgetPlan"
        },
        "details": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanDetails"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Exclusions",
          "type": "array"
        },
        "source_scope": {
          "$ref": "#/$defs/SourceScope"
        },
        "sub_questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Sub Questions",
          "type": "array"
        }
      },
      "required": [
        "sub_questions",
        "source_scope",
        "budget_plan"
      ],
      "title": "PlanModification",
      "type": "object"
    },
    "ResearchSubquestion": {
      "additionalProperties": false,
      "properties": {
        "evidence_required": {
          "enum": [
            "fulltext",
            "abstract",
            "metadata"
          ],
          "title": "Evidence Required",
          "type": "string"
        },
        "priority": {
          "default": "normal",
          "enum": [
            "critical",
            "high",
            "normal"
          ],
          "title": "Priority",
          "type": "string"
        },
        "question": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "subquestion_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Subquestion Id",
          "type": "string"
        }
      },
      "required": [
        "subquestion_id",
        "question",
        "evidence_required"
      ],
      "title": "ResearchSubquestion",
      "type": "object"
    },
    "SourceScope": {
      "properties": {
        "max_papers": {
          "default": 5,
          "title": "Max Papers",
          "type": "integer"
        },
        "min_papers": {
          "default": 3,
          "title": "Min Papers",
          "type": "integer"
        },
        "providers": {
          "items": {
            "type": "string"
          },
          "title": "Providers",
          "type": "array"
        },
        "year_from": {
          "title": "Year From",
          "type": "integer"
        },
        "year_to": {
          "title": "Year To",
          "type": "integer"
        }
      },
      "required": [
        "providers",
        "year_from",
        "year_to"
      ],
      "title": "SourceScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Decision bound to a delivery plan, distinct from the workflow M3 contract.",
  "properties": {
    "action": {
      "enum": [
        "approve",
        "modify",
        "reject"
      ],
      "title": "Action",
      "type": "string"
    },
    "execution_authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionAuthorization"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modified_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanModification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Digest"
    },
    "plan_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Version"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "action"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
