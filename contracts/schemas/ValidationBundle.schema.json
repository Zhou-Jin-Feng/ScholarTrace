{
  "$defs": {
    "ClaimValidation": {
      "additionalProperties": false,
      "properties": {
        "checked_evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Checked Evidence Ids",
          "type": "array"
        },
        "claim_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "maxItems": 1000,
          "title": "Issues",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "validated_at": {
          "format": "date-time",
          "title": "Validated At",
          "type": "string"
        },
        "validation_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Validation Id",
          "type": "string"
        }
      },
      "required": [
        "validation_id",
        "claim_id",
        "passed",
        "validated_at"
      ],
      "title": "ClaimValidation",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "claim_missing_evidence",
            "evidence_missing",
            "evidence_paper_missing",
            "content_hash_mismatch",
            "binding_missing",
            "document_key_mismatch",
            "index_id_mismatch",
            "source_hash_mismatch",
            "chunk_missing",
            "chunk_hash_mismatch",
            "quote_not_in_chunk",
            "char_range_mismatch",
            "page_mismatch",
            "numeric_mismatch",
            "version_target_missing",
            "citation_edge_missing",
            "lifecycle_incomplete"
          ],
          "title": "Code",
          "type": "string"
        },
        "evidence_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "issue_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Issue Id",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "paper_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "code",
        "severity",
        "message",
        "claim_id"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Bundle Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "degraded",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ClaimValidation"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "results",
    "outcome",
    "generated_at"
  ],
  "title": "ValidationBundle",
  "type": "object"
}
