{
  "additionalProperties": false,
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract"
    },
    "access_level": {
      "enum": [
        "abstract",
        "metadata"
      ],
      "title": "Access Level",
      "type": "string"
    },
    "arxiv_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arxiv Id"
    },
    "arxiv_version": {
      "anyOf": [
        {
          "maximum": 999,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arxiv Version"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Authors",
      "type": "array"
    },
    "candidate_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Candidate Id",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "openalex_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Openalex Id"
    },
    "publication_year": {
      "maximum": 2100,
      "minimum": 1900,
      "title": "Publication Year",
      "type": "integer"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "semantic_scholar_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Scholar Id"
    },
    "source": {
      "enum": [
        "arxiv",
        "openalex",
        "crossref",
        "semantic_scholar"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "title": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "source",
    "source_id",
    "title",
    "authors",
    "publication_year",
    "access_level",
    "retrieved_at",
    "record_sha256"
  ],
  "title": "PaperCandidate",
  "type": "object"
}
