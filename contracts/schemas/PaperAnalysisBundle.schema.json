{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "fact",
            "result",
            "comparison",
            "causal",
            "inference"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "counter_evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Counter Evidence Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Ids",
          "type": "array"
        },
        "importance": {
          "default": "supporting",
          "enum": [
            "critical",
            "supporting"
          ],
          "title": "Importance",
          "type": "string"
        },
        "origin": {
          "enum": [
            "author_stated",
            "cross_paper_synthesis",
            "system_inferred"
          ],
          "title": "Origin",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "claim_type",
        "origin"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "canonical_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Canonical Paper Id",
          "type": "string"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "chunk_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Content Sha256"
        },
        "chunk_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "document_key": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Key"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_level": {
          "enum": [
            "fulltext",
            "abstract",
            "metadata"
          ],
          "title": "Evidence Level",
          "type": "string"
        },
        "index_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Id"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "parser_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Version"
        },
        "quote": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "retrieval_run_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Run Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "source_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "evidence_id",
        "canonical_paper_id",
        "quote",
        "evidence_level",
        "content_sha256"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PaperCard": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Authors",
          "type": "array"
        },
        "canonical_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Canonical Paper Id",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        },
        "contributions": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Contributions",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generator": {
          "enum": [
            "ollama_qwen3_8b",
            "fixture"
          ],
          "title": "Generator",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "limitations": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "model_profile_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 3,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Profile Id"
        },
        "paper_card_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Paper Card Id",
          "type": "string"
        },
        "publication_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Publication Year",
          "type": "integer"
        },
        "question": {
          "maxLength": 4000,
          "minLength": 2,
          "title": "Question",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "paper_card_id",
        "canonical_paper_id",
        "title",
        "authors",
        "publication_year",
        "question",
        "summary",
        "contributions",
        "limitations",
        "claim_ids",
        "evidence_ids",
        "generator",
        "input_sha256",
        "generated_at"
      ],
      "title": "PaperCard",
      "type": "object"
    },
    "RetrievalAudit": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "maximum": 3,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "canonical_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Canonical Paper Id",
          "type": "string"
        },
        "chunk_count": {
          "default": 0,
          "maximum": 20,
          "minimum": 0,
          "title": "Chunk Count",
          "type": "integer"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "document_key": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Document Key",
          "type": "string"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "document_not_found",
                "stale_document_index",
                "document_operation_in_progress",
                "document_index_unavailable",
                "request_too_large",
                "validation_error",
                "retrieval_service_unavailable",
                "service_unavailable",
                "retrieval_capacity_exceeded",
                "retrieval_timeout"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "index_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Index Id",
          "type": "string"
        },
        "query_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "retrieval_run_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Retrieval Run Id",
          "type": "string"
        },
        "retrieval_version": {
          "anyOf": [
            {
              "const": "dense-v1",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Version"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "service_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Version"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "empty",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "retrieval_run_id",
        "canonical_paper_id",
        "document_key",
        "index_id",
        "source_sha256",
        "query_sha256",
        "started_at",
        "completed_at",
        "duration_seconds",
        "attempts",
        "status"
      ],
      "title": "RetrievalAudit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "paper_card": {
      "$ref": "#/$defs/PaperCard"
    },
    "retrieval_audit": {
      "$ref": "#/$defs/RetrievalAudit"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "paper_card",
    "claims",
    "evidence",
    "retrieval_audit"
  ],
  "title": "PaperAnalysisBundle",
  "type": "object"
}
