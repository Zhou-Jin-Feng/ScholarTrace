    "excerpt": {
      "title": "Excerpt",
      "type": "string"
    },
    "excerpt_is_verbatim": {
      "title": "Excerpt Is Verbatim",
      "type": "boolean"
    },
    "inference_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
