{
  "$defs": {
    "PaperSource": {
      "additionalProperties": false,
      "properties": {
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source": {
          "enum": [
            "arxiv",
            "openalex",
            "crossref",
            "semantic_scholar"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_id",
        "retrieved_at",
        "record_sha256"
      ],
      "title": "PaperSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstract"
    },
    "access_level": {
      "enum": [
        "fulltext",
        "abstract",
        "metadata"
      ],
      "title": "Access Level",
      "type": "string"
    },
    "arxiv_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arxiv Id"
    },
    "authors": {
      "items": {
        "maxLength": 8000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Authors",
      "type": "array"
    },
    "canonical_paper_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Canonical Paper Id",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "normalized_title": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Normalized Title",
      "type": "string"
    },
    "openalex_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Openalex Id"
    },
    "publication_year": {
      "maximum": 2100,
      "minimum": 1900,
      "title": "Publication Year",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_scholar_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Scholar Id"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/PaperSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "title": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version_of": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version Of"
    }
  },
  "required": [
    "canonical_paper_id",
    "title",
    "normalized_title",
    "authors",
    "publication_year",
    "access_level",
    "sources"
  ],
  "title": "Paper",
  "type": "object"
}
