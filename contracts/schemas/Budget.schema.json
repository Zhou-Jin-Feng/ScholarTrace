          "default": 16,
          "maximum": 200,
          "minimum": 0,
          "title": "Max Api Calls",
          "type": "integer"
        },
        "max_candidate_papers": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "title": "Max Candidate Papers",
          "type": "integer"
