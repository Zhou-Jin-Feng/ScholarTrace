          "default": 6,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Rag Calls Per Paper",
          "type": "integer"
        },
        "max_rounds": {
          "default": 2,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "max_total_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Total Tokens"
