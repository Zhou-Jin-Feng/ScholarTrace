        "max_cost_cny": {
          "default": 10.0,
          "minimum": 0,
          "title": "Max Cost Cny",
          "type": "number"
        },
        "max_duration_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 30,
          "title": "Max Duration Seconds",
          "type": "integer"
        },
        "max_fulltext_papers": {
          "default": 15,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Fulltext Papers",
          "type": "integer"
