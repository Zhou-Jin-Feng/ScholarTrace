{
  "$defs": {
    "CitationEdge": {
      "additionalProperties": false,
      "properties": {
        "cited_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Cited Paper Id",
          "type": "string"
        },
        "citing_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Citing Paper Id",
          "type": "string"
        },
        "edge_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Edge Id",
          "type": "string"
        },
        "relation": {
          "const": "references",
          "default": "references",
          "title": "Relation",
          "type": "string"
        },
        "request_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "response_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Response Sha256",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "openalex",
            "semantic_scholar"
          ],
          "title": "Source",
          "type": "string"
        },
        "source_work_id": {
          "pattern": "^W\\d+$",
          "title": "Source Work Id",
          "type": "string"
        }
      },
      "required": [
        "edge_id",
        "citing_paper_id",
        "cited_paper_id",
        "source",
        "source_work_id",
        "request_id",
        "response_sha256",
        "retrieved_at"
      ],
      "title": "CitationEdge",
      "type": "object"
    },
    "CitationNode": {
      "additionalProperties": false,
      "properties": {
        "analysis_ready": {
          "default": false,
          "title": "Analysis Ready",
          "type": "boolean"
        },
        "lifecycle_stage": {
          "anyOf": [
            {
              "enum": [
                "normalized",
                "relevance_passed",
                "access_resolved",
                "acquired",
                "ingested",
                "analyzed",
                "rejected",
                "failed"
              ],
              "type": "string"
            },
            {
              "const": "external_metadata_missing",
              "type": "string"
            }
          ],
          "title": "Lifecycle Stage"
        },
        "paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Paper Id",
          "type": "string"
        },
        "publication_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Year"
        },
        "seed": {
          "default": false,
          "title": "Seed",
          "type": "boolean"
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "title",
        "lifecycle_stage"
      ],
      "title": "CitationNode",
      "type": "object"
    },
    "CitationNodeMetric": {
      "additionalProperties": false,
      "properties": {
        "community_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Community Id",
          "type": "string"
        },
        "component_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Component Id",
          "type": "string"
        },
        "in_degree": {
          "minimum": 0,
          "title": "In Degree",
          "type": "integer"
        },
        "out_degree": {
          "minimum": 0,
          "title": "Out Degree",
          "type": "integer"
        },
        "pagerank": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pagerank",
          "type": "number"
        },
        "paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Paper Id",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "in_degree",
        "out_degree",
        "pagerank",
        "component_id",
        "community_id"
      ],
      "title": "CitationNodeMetric",
      "type": "object"
    },
    "CitationTimelineCandidate": {
      "additionalProperties": false,
      "properties": {
        "citation_edge_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Citation Edge Id",
          "type": "string"
        },
        "earlier_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Earlier Paper Id",
          "type": "string"
        },
        "later_paper_id": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Later Paper Id",
          "type": "string"
        },
        "year_gap": {
          "maximum": 200,
          "minimum": 0,
          "title": "Year Gap",
          "type": "integer"
        }
      },
      "required": [
        "earlier_paper_id",
        "later_paper_id",
        "year_gap",
        "citation_edge_id"
      ],
      "title": "CitationTimelineCandidate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "communities": {
      "items": {
        "items": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "type": "string"
        },
        "type": "array"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Communities",
      "type": "array"
    },
    "components": {
      "items": {
        "items": {
          "maxLength": 160,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "type": "string"
        },
        "type": "array"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/CitationEdge"
      },
      "maxItems": 50000,
      "title": "Edges",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "graph_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
      "title": "Graph Id",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/CitationNodeMetric"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/CitationNode"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "partial": {
      "default": false,
      "title": "Partial",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timeline_candidates": {
      "items": {
        "$ref": "#/$defs/CitationTimelineCandidate"
      },
      "maxItems": 50000,
      "title": "Timeline Candidates",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "graph_id",
    "nodes",
    "metrics",
    "components",
    "communities",
    "generated_at",
    "content_sha256"
  ],
  "title": "CitationGraphArtifact",
  "type": "object"
}
