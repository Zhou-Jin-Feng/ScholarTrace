{
  "openapi": "3.1.0",
  "info": {
    "title": "ScholarGraph Read-Only Query API",
    "version": "0.1.0-draft",
    "description": "M0 draft for a future thin HTTP adapter over ScholarGraph run_query. This API is not implemented in ScholarGraph commit 953e40b."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8002"
    }
  ],
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getScholarGraphLiveness",
        "responses": {
          "200": {
            "description": "The adapter process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getScholarGraphReadiness",
        "responses": {
          "200": {
            "description": "The fixed corpus and read-only index are available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "operationId": "getScholarGraphCapabilities",
        "responses": {
          "200": {
            "description": "Versioned fixed-corpus capability declaration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                },
                "example": {
                  "schema_version": "1.0",
                  "service_version": "1.0.0",
                  "graphrag_version": "3.1.2",
                  "corpora": [
                    {
                      "corpus_id": "rag-openalex-2020-2025-198-v1",
                      "topic": "retrieval-augmented generation",
                      "year_from": 2020,
                      "year_to": 2025,
                      "document_count": 198,
                      "evidence_level": "abstract",
                      "methods": ["basic", "local", "global", "drift"],
                      "default_method": "basic"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/query": {
      "post": {
        "operationId": "queryScholarGraph",
        "description": "Execute a validated read-only query against one declared fixed corpus.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query completed or returned a stable non-success status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "422": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "503": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "ErrorResponse": {
        "description": "Stable public error envelope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "service_version", "ready"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["alive", "ready", "not_ready"]
          },
          "service_version": {
            "type": "string"
          },
          "ready": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CorpusCapability": {
        "type": "object",
        "required": [
          "corpus_id",
          "topic",
          "year_from",
          "year_to",
          "document_count",
          "evidence_level",
          "methods",
          "default_method"
        ],
        "properties": {
          "corpus_id": {
            "const": "rag-openalex-2020-2025-198-v1"
          },
          "topic": {
            "const": "retrieval-augmented generation"
          },
          "year_from": {
            "const": 2020
          },
          "year_to": {
            "const": 2025
          },
          "document_count": {
            "const": 198
          },
          "evidence_level": {
            "const": "abstract"
          },
          "methods": {
            "type": "array",
            "prefixItems": [
              {"const": "basic"},
              {"const": "local"},
              {"const": "global"},
              {"const": "drift"}
            ],
            "items": false
          },
          "default_method": {
            "const": "basic"
          }
        },
        "additionalProperties": false
      },
      "CapabilitiesResponse": {
        "type": "object",
        "required": ["schema_version", "service_version", "graphrag_version", "corpora"],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "service_version": {
            "type": "string"
          },
          "graphrag_version": {
            "const": "3.1.2"
          },
          "corpora": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/components/schemas/CorpusCapability"
            }
          }
        },
        "additionalProperties": false
      },
      "QueryRequest": {
        "type": "object",
        "required": ["schema_version", "corpus_id", "question", "method", "timeout_seconds"],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "corpus_id": {
            "const": "rag-openalex-2020-2025-198-v1"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "method": {
            "type": "string",
            "enum": ["basic", "local", "global", "drift"],
            "default": "basic"
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 5,
            "maximum": 3600
          }
        },
        "additionalProperties": false
      },
      "SourceRef": {
        "type": "object",
        "required": ["canonical_paper_id", "openalex_id", "evidence_level"],
        "properties": {
          "canonical_paper_id": {
            "type": "string",
            "minLength": 3
          },
          "openalex_id": {
            "type": "string",
            "pattern": "^W[0-9]+$"
          },
          "evidence_level": {
            "const": "abstract"
          }
        },
        "additionalProperties": false
      },
      "QueryResponse": {
        "type": "object",
        "required": [
          "schema_version",
          "service_version",
          "graphrag_version",
          "corpus_id",
          "method",
          "status",
          "duration_seconds",
          "evidence_level",
          "answer",
          "source_refs",
          "diagnostics"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "service_version": {
            "type": "string"
          },
          "graphrag_version": {
            "const": "3.1.2"
          },
          "corpus_id": {
            "const": "rag-openalex-2020-2025-198-v1"
          },
          "method": {
            "type": "string",
            "enum": ["basic", "local", "global", "drift"]
          },
          "status": {
            "type": "string",
            "enum": ["succeeded", "failed", "timed_out", "unavailable"]
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "evidence_level": {
            "const": "abstract"
          },
          "answer": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            }
          },
          "diagnostics": {
            "type": "object",
            "required": ["public_message"],
            "properties": {
              "public_message": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "corpus_not_found",
                  "method_not_allowed",
                  "validation_error",
                  "index_unavailable",
                  "query_service_unavailable"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
