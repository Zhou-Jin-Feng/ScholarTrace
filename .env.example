# Custom OpenAI-compatible provider used by the opt-in api-strong route.
# Keep the real key in your local environment or an untracked .env file.
SCHOLARTRACE_API_BASE_URL=https://provider.example/v1
SCHOLARTRACE_API_KEY=
SCHOLARTRACE_API_TIMEOUT_SECONDS=20
# Use auto for endpoint-specific defaults; DeepSeek uses json_object.
SCHOLARTRACE_API_STRUCTURED_OUTPUT_MODE=auto
# Set a model identifier supported by the selected provider.
SCHOLARTRACE_API_MODEL=gpt-5.6-terra

# Deployment boundary: loopback is the safe local default.
# trusted_private requires a shared token of at least 16 non-whitespace characters.
SCHOLARTRACE_DEPLOYMENT_MODE=loopback
SCHOLARTRACE_AUTH_TOKEN=
# Compose binds both API and UI to this address unless explicitly overridden.
SCHOLARTRACE_BIND_ADDRESS=127.0.0.1
# Optional host data path; relative paths resolve from the project root.
# SCHOLARTRACE_DATA_DIR=data/tasks
# Container path is separate from host paths; keep it inside the mounted volume.
SCHOLARTRACE_CONTAINER_DATA_DIR=/var/lib/scholartrace
